<Project Sdk="Microsoft.NET.Sdk">
  <!-- What salamander's clr tests call into. zig build builds it with the dotnet SDK. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Writes Probe.runtimeconfig.json, which a host needs to start or join a runtime -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RollForward>LatestMajor</RollForward>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Salamander.cs, the core traits and test.sal, generated by zig build. Its path is from where the build started. -->
  <ItemGroup Condition="'$(SalamanderDir)' != ''">
    <Compile Include="$([MSBuild]::NormalizeDirectory($(MSBuildStartupDirectory), $(SalamanderDir)))*.cs" />
  </ItemGroup>
</Project>
