{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "salamander tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\zig-out\\bin\\${input:testSuite}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "preLaunchTask": "build tests"
    },
    {
      "name": "salamander-gen",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\zig-out\\bin\\salamander-gen.exe",
      "args": [
        "zig",
        "${workspaceFolder}\\zig-out\\schema.zig",
        "${input:salFile}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "preLaunchTask": "build"
    }
  ],
  "inputs": [
    {
      "id": "testSuite",
      "type": "pickString",
      "description": "Test suite to debug",
      "default": "salamander_schema_tests",
      "options": [
        "salamander_agree_tests",
        "salamander_bind_tests",
        "salamander_c_tests",
        "salamander_dyn_tests",
        "salamander_hosts_tests",
        "salamander_js_tests",
        "salamander_lua_tests",
        "salamander_runtime_tests",
        "salamander_schema_tests",
        "salamander_script_tests",
        "salamander_sys_tests",
        "salamander_types_tests",
        "salamander_zig_tests"
      ]
    },
    {
      "id": "salFile",
      "type": "promptString",
      "description": ".sal file or folder to generate Zig from",
      "default": "src/schema/test.sal"
    }
  ]
}
